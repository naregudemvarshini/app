# Small helper: fallback summarizer if remote LLM not available
def simple_summarize(text: str, max_sentences: int = 3) -> str:
    # naive summarizer: pick top sentences by length (very rough)
    sentences = re.split(r'(?<=[.!?])\s+', text.strip())
    sentences = [s.strip() for s in sentences if len(s.strip()) > 20]
    sentences.sort(key=lambda s: len(s), reverse=True)
    return " ".join(sentences[:max_sentences]) if sentences else text[:200]

# -------------------------
# Document parsing utilities
# -------------------------
def extract_text_from_pdf(file_bytes: bytes) -> str:
    if pdfplumber is None:
        raise RuntimeError("pdfplumber not installed. Check requirements.txt")
    text_parts = []
    with pdfplumber.open(io.BytesIO(file_bytes)) as pdf:
        for page in pdf.pages:
            text_parts.append(page.extract_text() or "")
    return "\n".join(text_parts)

def extract_text_from_docx(file_bytes: bytes) -> str:
    if docx is None:
        raise RuntimeError("python-docx not installed. Check requirements.txt")
    tmp_path = Path("tmp_docx.docx")
    tmp_path.write_bytes(file_bytes)
    doc = docx.Document(str(tmp_path))
    paragraphs = [p.text for p in doc.paragraphs if p.text.strip()]
    tmp_path.unlink(missing_ok=True)
    return "\n".join(paragraphs)

def extract_text_from_image(file_bytes: bytes) -> str:
    if Image is None or pytesseract is None:
        raise RuntimeError("Pillow and pytesseract must be installed for OCR")
    image = Image.open(io.BytesIO(file_bytes))
    return pytesseract.image_to_string(image)

# Generic extractor
def extract_text(file: st.runtime.uploaded_file_manager.UploadedFile) -> str:
    name = file.name.lower()
    b = file.read()
    if name.endswith(".pdf"):
        return extract_text_from_pdf(b)
    elif name.endswith(".docx") or name.endswith(".doc"):
        return extract_text_from_docx(b)
    elif name.endswith((".png", ".jpg", ".jpeg", ".tiff")):
        return extract_text_from_image(b)
    else:
        # try decode as text fallback
        try:
            return b.decode("utf-8", errors="ignore")
        except Exception:
            return ""

# -------------------------
# Clause segmentation & heuristics
# -------------------------
CLAUSE_SEP_REGEX = re.compile(
    r'(^\s*(?:Clause|ARTICLE|Section|Sec\.?|[0-9]{1,2}[.)]\s).+?$)', re.IGNORECASE | re.MULTILINE
)

def segment_clauses(text: str) -> List[Dict[str, Any]]:
    """
    Heuristic clause segmentation:
    - Split on common clause headers (Clause, Section, Article, numbered paragraphs)
    - If no headers, split by paragraphs of reasonable length
    """
    if not text or len(text.strip()) < 50:
        return []

    matches = list(CLAUSE_SEP_REGEX.finditer(text))
    if matches:
        clauses = []
        for i, m in enumerate(matches):
            start = m.start()
            header = m.group(0).strip()
            end = matches[i + 1].start() if i + 1 < len(matches) else len(text)
            body = text[m.end():end].strip()
            clauses.append({"header": header, "body": body})
        return clauses
    else:
        # fallback: split by double newlines as paragraphs
        paras = [p.strip() for p in re.split(r'\n\s*\n', text) if len(p.strip()) > 30]
        return [{"header": f"Paragraph {i+1}", "body": p} for i, p in enumerate(paras)]

# -------------------------
# Remote model integrations
# -------------------------
def call_watson_nlu(text: str, features: Dict = None) -> Dict:
    """
    Call IBM Watson NLU. Expects environment variables:
    WATSON_APIKEY, WATSON_URL
    """
    api_key = os.getenv("WATSON_APIKEY")
    url = os.getenv("WATSON_URL")
    if not api_key or not url:
        return {"error": "Watson credentials not configured (WATSON_APIKEY/WATSON_URL)"}

    endpoint = url.rstrip("/") + "/v1/analyze"
    params = {"version": "2021-08-01"}
    payload = {"text": text, "features": features or {"entities": {}, "keywords": {}, "syntax": {}}}
    headers = {"Content-Type": "application/json"}
    auth = ("apikey", api_key)
    try:
        resp = requests.post(endpoint, params=params, json=payload, headers=headers, auth=auth, timeout=30)
        return resp.json()
    except Exception as e:
        return {"error": str(e)}

def call_granite_llm(prompt: str, max_tokens: int = 512) -> Dict:
    """
    Placeholder call to Granite LLM.
    Expects GRANITE_APIKEY and GRANITE_URL as env vars.
    The exact API shape will depend on Granite provider; adjust accordingly.
    """
    key = os.getenv("GRANITE_APIKEY")
    url = os.getenv("GRANITE_URL")
    if not key or not url:
        return {"error": "Granite credentials not configured (GRANITE_APIKEY/GRANITE_URL)"}

    # Example: POST {prompt, max_tokens} with Authorization Bearer
    headers = {"Authorization": f"Bearer {key}", "Content-Type": "application/json"}
    payload = {"prompt": prompt, "max_tokens": max_tokens}
    try:
        resp = requests.post(url, json=payload, headers=headers, timeout=30)
        return resp.json()
    except Exception as e:
        return {"error": str(e)}

# -------------------------
# Risk scoring (heuristic)
# -------------------------
RISK_KEYWORDS = {
    "high": ["penalty", "terminate", "liability", "indemnify", "breach", "arbitration", "governing law", "waive"],
    "medium": ["notice", "obligation", "warranty", "assignment", "subcontract", "confidential", "insurance"],
    "low": ["term", "term of agreement", "definition", "background"]
}

def score_clause_risk(text: str) -> Dict[str, Any]:
    t = text.lower()
    score = 0
    reasons = []
    for k in RISK_KEYWORDS["high"]:
        if k in t:
            score += 5
            reasons.append(f"high_kw:{k}")
    for k in RISK_KEYWORDS["medium"]:
        if k in t:
            score += 2
            reasons.append(f"med_kw:{k}")
    for k in RISK_KEYWORDS["low"]:
        if k in t:
            score += 1
    # normalize to 0-100
    normalized = min(100, int(score * 6))
    level = "Low"
    if normalized >= 60:
        level = "High"
    elif normalized >= 30:
        level = "Medium"
    return {"score": normalized, "level": level, "reasons": reasons}

