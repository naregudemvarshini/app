def embed_texts(texts: List[str]) -> List[List[float]]:
    """
    Stub for embeddings. Replace with actual embedding model or vector DB.
    """
    # naive hash-based pseudo-embedding (DO NOT use in production)
    embeddings = []
    for t in texts:
        h = abs(hash(t)) % 10000
        # simple 8-d vector from hash
        vec = [((h >> i) & 255) / 255.0 for i in range(0, 64, 8)]
        embeddings.append(vec)
    return embeddings

